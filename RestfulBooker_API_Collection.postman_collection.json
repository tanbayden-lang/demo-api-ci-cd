                  "});",
                  "",
                  "// Chỉ đọc JSON nếu Status Code trả về là 200 OK",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    ",
                  "    // Lưu bookingid vào Environment Variable",
                  "    if (jsonData.bookingid) {",
                  "        pm.environment.set(\"bookingid\", jsonData.bookingid);",
                  "    }",
                  "",
                  "    // Kiểm tra firstname nếu chạy qua Collection Runner (với file CSV)",
                  "    var expectedFirstName = pm.iterationData.get(\"firstname\");",
                  "    if (expectedFirstName) {",
                  "        pm.test(\"Tên khách hàng khớp với dữ liệu đầu vào\", function () {",
                  "            pm.expect(jsonData.booking.firstname).to.eql(expectedFirstName);",
                  "        });",
                  "    }",
                  "}"
