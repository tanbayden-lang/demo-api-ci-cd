                  "});",
                  "",
                  "pm.test(\"Nội dung báo lỗi không tìm thấy (Not Found / Method Not Allowed)\", function () {",
                  "    var responseText = pm.response.text();",
                  "    // Kiểm tra xem phản hồi có chứa một trong các từ báo lỗi phổ biến của server không",
                  "    pm.expect(responseText).to.satisfy(function(text) {",
                  "        return text.includes(\"Not Found\") || text.includes(\"Method Not Allowed\") || text.includes(\"Forbidden\") || text.length > 0;",
                  "    });",
                  "});"
